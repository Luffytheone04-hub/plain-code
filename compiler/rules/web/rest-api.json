{
  "name": "rest-api",
  "category": "web",
  "version": 1,
  "title": "REST API",
  "purpose": "REST API servers with Express: routes, request data, JSON responses, path/query parameters, and middleware.",
  "keywords": [
    "rest",
    "api",
    "server",
    "route",
    "middleware",
    "express",
    "listen"
  ],
  "triggers": [
    { "type": "regex", "pattern": "express app" },
    { "type": "regex", "pattern": "\\bapp get\\b" },
    { "type": "regex", "pattern": "\\bapp post\\b" },
    { "type": "regex", "pattern": "\\bapp put\\b" },
    { "type": "regex", "pattern": "\\bapp patch\\b" },
    { "type": "regex", "pattern": "\\bapp delete\\b" },
    { "type": "regex", "pattern": "\\bapp use\\b" },
    { "type": "regex", "pattern": "listen app on port" }
  ],
  "dependencies": ["express"],
  "imports": [],
  "async": false,
  "compilerMin": "2.0.0",
  "resolvablePaths": ["web/rest-api", "web/rest-api.json"]
}
