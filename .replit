modules = ["nodejs-14"]
[nix]
channel = "stable-25_05"
packages = ["next-ls"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Docs preview"

[[workflows.workflow]]
name = "Docs preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx serve docs -p 5000 --no-clipboard"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
