// Plain v0.2 comprehensive installed-package test
use math
use sqlite

remember name as "Ayokunle"
remember score as 10
remember count as 0
remember players as [
    "Haaland",
    "Foden",
    "Rodri"
]

remember user as
    name is "Ayokunle"
    age is 17
    country is "Nigeria"
done

show name
show players[0]
players[1] becomes "Palmer"
show players[1]
show user.name
user.age becomes 18
show user.age

if score is 10
    show "Score matches"
done

if score is greater than 5
    show "Score is high"
otherwise
    show "Score is low"
done

if score is less than 20
    show "Score is below 20"
done

make add(a, b)
    give a + b
done

make greet()
    show uppercase("hello from Plain")
done

greet()
show add(5, 7)
show length(players)
show uppercase("plain")
show lowercase("PLAIN")
show round(3)
show random()

for each player in players
    show player
done

while count is less than 3
    count becomes count + 1
done

show count
